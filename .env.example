# ================= LLM（三选一；不配置则用 mock 演示模式） =================

# ---- DeepSeek（推荐，便宜够用）----
ASKDATA_LLM_PROVIDER=deepseek
ASKDATA_LLM_API_KEY=sk-xxxxxxxx
# 可选覆盖模型：ASKDATA_LLM_MODEL=deepseek-chat

# ---- Gemini（免费额度，OpenAI 兼容端点）----
# ASKDATA_LLM_PROVIDER=gemini
# ASKDATA_LLM_API_KEY=AIza...
# ASKDATA_LLM_MODEL=gemini-2.5-flash

# ---- 任意 OpenAI 兼容接口 ----
# ASKDATA_LLM_PROVIDER=openai
# ASKDATA_LLM_BASE_URL=https://your-endpoint/v1
# ASKDATA_LLM_MODEL=your-model

# ================= 沙箱 =================
# 用户代码最长执行时间（秒）
ASKDATA_SANDBOX_TIMEOUT_S=5
# 用户代码内存上限（MB）
ASKDATA_SANDBOX_MEMORY_MB=512

# ================= 其它 =================
# 数据目录（上传文件 / 图表 / 示例数据）；默认项目内 data/
# ASKDATA_DATA_DIR=D:\Codex\workspace\AskData\data
ASKDATA_MAX_UPLOAD_MB=20
ASKDATA_SESSION_TTL_MINUTES=120

